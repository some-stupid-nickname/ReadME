# Dockerfile for Telegram Bot
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies if needed
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements if exists
COPY telegram-bot/requirements.txt /app/requirements.txt 2>/dev/null || echo "# No requirements" > /app/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt || echo "No requirements to install"

# Copy telegram bot code
COPY telegram-bot/ /app/

# Health check (basic process check)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD pgrep -f "python.*bot" || exit 1

# Default command (should be overridden in docker-compose)
CMD ["python", "main.py"]

