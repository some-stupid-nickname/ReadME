# Qdrant configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Collection settings
COLLECTION_NAME=books
BATCH_SIZE=100

# Data path
DATA_PATH=../data/processed/BooksDatasetClean.csv

# LLM API configuration (for LLM-as-Judge evaluation)
# Mistral (free tier available) - Get key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenAI (optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
